// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Users {
  id        String     @id @default(uuid())
  login     String
  role      Roles      @default(READER)
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  // Soft-delete marker. NULL = active user.
  deletedAt DateTime?
  profile   Profiles[]
  order     Orders[]
  notes     Notes[]
}

model Profiles {
  id          String @id @default(uuid())
  phoneNumber Int
  age         Int
  country     String
  user        Users  @relation(fields: [userId], references: [id])
  userId      String @unique
}

model Books {
  id          String       @id @default(uuid())
  title       String
  author      String
  releaseYear Int
  category    Categories   @default(FOR_CHILDREN)
  order       Orders       @relation(fields: [orderId], references: [id])
  orderId     String       @unique
  genre       BookGenres[]
  notes       Notes[]
}

/// Reading notes / highlights a user creates while reading a book.
model Notes {
  id           String   @id @default(uuid())
  user         Users    @relation(fields: [userId], references: [id])
  userId       String
  book         Books    @relation(fields: [bookId], references: [id])
  bookId       String
  selectedText String
  comment      String?
  pageNumber   Int?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([bookId])
  @@index([userId, bookId])
}

model Genres {
  id   String       @id @default(uuid())
  name String
  book BookGenres[]
}

model BookGenres {
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  book      Books     @relation(fields: [bookId], references: [id])
  genre     Genres    @relation(fields: [genreId], references: [id])
  bookId    String
  genreId   String

  @@id([genreId, bookId])
}

model Orders {
  id     String  @id @default(uuid())
  user   Users   @relation(fields: [userId], references: [id])
  userId String  @unique
  book   Books[]
  paid   Boolean
  term   Int
}

enum Categories {
  FOR_CHILDREN
  FOR_TEENS
  FOR_ADULTS
}

enum Roles {
  ADMIN
  MANAGER
  READER
}
