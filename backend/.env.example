# ---- Server ----
PORT=3000

# ---- Database (Prisma / PostgreSQL) ----
DATABASE_URL="postgresql://postgres:user@localhost:5432/library?connect_timeout=300"

# ---- JWT / Auth ----
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# ---- Books Parser providers ----
# Optional. Without a key Google Books still works but with stricter quotas.
GOOGLE_BOOKS_API_KEY=""
# Open Library has no key requirement.

# ---- AI / OpenAI ----
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
